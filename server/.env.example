# ===== Core =====
NODE_ENV=development
PORT=4000
# Public URL of the site (required in production; also used for CORS + email links)
APP_ORIGIN=http://localhost:4000
BRAND_NAME=Matchify
DATABASE_URL=postgres://postgres:postgres@localhost:5432/matchify
# Random 32+ char strings. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
REFRESH_SECRET=change-this-too-another-long-random-string-32-chars
LOG_LEVEL=info
# Set to 1 when behind exactly one proxy (Render, Heroku, Cloudflare→Render needs 2)
TRUST_PROXY=1

# ===== Demo data (NEVER effective when NODE_ENV=production; the server refuses to boot if both are set) =====
DEMO_MODE=false

# ===== 18+ verification (production REQUIRES a real provider) =====
REQUIRE_AGE_VERIFICATION=true
# mock (dev/test only) | persona | generic
VERIFICATION_PROVIDER=mock
VERIFICATION_WEBHOOK_SECRET=change-me-webhook-secret
# generic provider (your own adapter in front of HyperVerge / IDfy / Signzy / Digio ...)
VERIFICATION_START_URL=
VERIFICATION_API_KEY=
# persona provider
PERSONA_API_KEY=
PERSONA_TEMPLATE_AGE=
PERSONA_TEMPLATE_SELFIE=

# ===== Sign-in / messaging =====
GOOGLE_CLIENT_ID=
SMTP_URL=
EMAIL_FROM="Matchify <no-reply@yourdomain.com>"
# SMS OTP: twilio (or leave empty in dev → codes are logged). India needs TRAI DLT registration.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ===== Photos =====
# local (default, ./uploads — NOT durable on Render free) | s3 (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# none | sightengine  (production + none => every photo goes to the human review queue)
IMAGE_MODERATION_PROVIDER=none
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# ===== Payments (Razorpay) =====
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Non-production only: lets you click through checkout without Razorpay
PAYMENTS_DEV_MODE=false
DAY_PASS_ENABLED=false

# ===== AI (optional; every AI feature has a non-AI fallback) =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_TALK_DAILY_LIMIT=60

# ===== Calls (WebRTC) — TURN is strongly recommended for mobile networks =====
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=

# ===== Push notifications: npx web-push generate-vapid-keys =====
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# ===== Staff / ops =====
REQUIRE_STAFF_2FA=
CALLS_REQUIRE_MESSAGES=true
DISABLE_JOBS=false
INACTIVE_NOTICE_DAYS=180
INACTIVE_DELETE_DAYS=365
