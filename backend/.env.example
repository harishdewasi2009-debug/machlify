# Copy to .env and fill in. Required values have no default and the server refuses to start without them.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/matchify

# The address users open in the browser (the backend serves the frontend too).
APP_ORIGIN=http://localhost:4000
EXTRA_ORIGINS=
# Use your real domain in production; "localhost" / onrender.com are treated as host-only cookies.
COOKIE_DOMAIN=localhost

# Two DIFFERENT random secrets (openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Separate again; without it admin login answers 503.
ADMIN_JWT_SECRET=

EMAIL_FROM=no-reply@matchify.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional integrations (leave blank to disable)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
MODERATION_API_USER=
MODERATION_API_SECRET=
ALLOW_UNMODERATED_PHOTOS=true
STRIPE_SECRET_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=
REQUIRE_IDENTITY_VERIFICATION=false
RAZORPAY_KEY_ID=rzp_live_TAexYrYEZdqZdH
RAZORPAY_KEY_SECRET=   # paste from Razorpay Dashboard. NEVER commit or share this
RAZORPAY_WEBHOOK_SECRET=b35c67b74f5b4bb2e76cf7022295f001623bbe76bdbbc30b
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Demo accounts (set SEED_DEMO=false for a real launch)
SEED_DEMO=true
